ARG SCIENCE_IMAGE=a-maslov-det-rep-experiment:ec750-b2d5ed6
FROM ${SCIENCE_IMAGE} AS science_packages

FROM vllm/vllm-openai@sha256:370670abb329811c4c44c5712dbacc1d03a3b1be87c55fe3dfd62ea4a76f506b

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/work \
    VIRTUAL_ENV=/opt/det-rep-venv \
    PATH=/opt/det-rep-venv/bin:$PATH

RUN mkdir -p /work /app /opt/det-rep-venv \
    && chown -R 65532:65532 /opt/det-rep-venv /work /app
USER 65532:65532
WORKDIR /app
RUN python3 -m venv /opt/det-rep-venv
COPY --from=science_packages --chown=65532:65532 /opt/venv/lib/python3.12/site-packages /opt/det-rep-venv/lib/python3.12/site-packages
COPY --chown=65532:65532 . ./
RUN chmod -R a+rX /app

ENTRYPOINT ["/bin/sh", "/app/scripts/experiment-entrypoint.sh"]
